<?xml version="1.0" encoding="UTF-8"?>
<system>
    <memory_region name="guest_ram" size="0x10_000_000" />
    <memory_region name="serial" size="0x1_000" phys_addr="0x9000000" />
    <memory_region name="gic_vcpu" size="0x1_000" phys_addr="0x8040000" />

    <protection_domain name="robotics_bridge" priority="200">
        <program_image path="robotics_bridge.elf" />
    </protection_domain>

    <protection_domain name="safety_runtime" priority="150">
        <program_image path="safety_runtime.elf" />
    </protection_domain>

    <protection_domain name="VMM" priority="100">
        <program_image path="vmm_robotics.elf" />
        <map mr="guest_ram" vaddr="0x40000000" perms="rw" setvar_vaddr="guest_ram_vaddr" />
        <virtual_machine name="linux">
            <vcpu id="0" />
            <map mr="guest_ram" vaddr="0x40000000" perms="rwx" />
            <map mr="serial" vaddr="0x9000000" perms="rw" cached="false" />
            <map mr="gic_vcpu" vaddr="0x8010000" perms="rw" cached="false" />
        </virtual_machine>
        <irq irq="33" id="1" />
    </protection_domain>

    <!-- channel: VMM <-> robotics_bridge (protected call) -->
    <channel>
        <end pd="VMM" id="2" />
        <end pd="robotics_bridge" id="0" pp="true" />
    </channel>

    <!-- channel: robotics_bridge <-> safety_runtime (notification) -->
    <channel>
        <end pd="robotics_bridge" id="1" />
        <end pd="safety_runtime" id="0" />
    </channel>
</system>
